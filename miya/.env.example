# === Обязательно ===
# Ключ Gemini API (бесплатно: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Пароль для входа в приложение (чтобы никто чужой не тратил ваш ключ)
APP_PASSWORD=

# === Хранилище памяти (Upstash Redis, бесплатно через Vercel Marketplace) ===
# Vercel подставит их сам после подключения интеграции Upstash.
# Подходит любая пара: KV_REST_API_URL/KV_REST_API_TOKEN или UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === Push-уведомления (сгенерировать: npm run vapid) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Секрет для /api/cron (Vercel Cron передаёт его сам в заголовке Authorization)
CRON_SECRET=

# === Необязательно ===
# Модель Gemini (по умолчанию gemini-flash-latest, при ошибке — запасные модели)
GEMINI_MODEL=
# Часовой пояс пользователя (для расписания и «сейчас утро/вечер»)
MIYA_TIMEZONE=Europe/Moscow
# Как Мия обращается к вам (можно поменять и в настройках приложения)
USER_NAME=
